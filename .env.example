# --- Database (Neon or any Postgres) -------------------------------------
# Local dev:  postgres://parity:parity@localhost:5432/parity
DATABASE_URL="postgres://parity:parity@localhost:5432/parity"

# --- Auth.js -------------------------------------------------------------
AUTH_SECRET=""                       # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# --- Email (Resend) — magic links + Part 9 job notifications --------------
RESEND_API_KEY=""
EMAIL_FROM="Parity <parity@example.com>"

# --- Cron (Vercel Cron calls these with this bearer token) ----------------
CRON_SECRET=""

# --- Observability -------------------------------------------------------
LOG_LEVEL="info"                     # debug | info | warn | error
METRICS_ENABLED="true"
# Set to expose /api/metrics without auth in local dev only.
METRICS_PUBLIC="false"

# --- Feature flags -------------------------------------------------------
# §1.4: LLM summarisation is optional, labelled, and NEVER in a numeric path.
FEATURE_LLM_SUMMARY="false"
